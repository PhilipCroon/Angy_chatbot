# Angy Chatbot with FHIR Integration - Environment Variables

# ============================================================================
# OpenAI Configuration (for LLM and message decomposition)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# PhenoML / Lang2FHIR Configuration (REQUIRED)
# ============================================================================
PHENOML_USERNAME=your_phenoml_username
PHENOML_PASSWORD=your_phenoml_password
PHENOML_BASE_URL=https://experiment.app.pheno.ml

# Angy Intake Agent ID (created with build_intake_agent.py)
ANGY_AGENT_ID=8a9ffa61-e447-4af9-8f0f-2834ca082a21

# ============================================================================
# Medplum Configuration (OPTIONAL - for EHR storage)
# ============================================================================
# Leave blank or use placeholder values to skip Medplum integration
MEDPLUM_CLIENT_ID=your_medplum_client_id
MEDPLUM_CLIENT_SECRET=your_medplum_client_secret
MEDPLUM_BASE_URL=https://api.medplum.com

# ============================================================================
# LLM Provider Configuration (for Angy chatbot)
# ============================================================================
# Options: "openai" or "ollama"
ANGY_LLM_PROVIDER=openai

# Ollama configuration (if using Ollama)
ANGY_OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
ANGY_OLLAMA_TIMEOUT=60.0

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8005
